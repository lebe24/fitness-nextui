# Copy this file to .env.local, then restart the dev server.
#
# The exercise catalogue and its media need no key: the data ships in
# public/exercises.json and the images come from a pinned CDN copy of the
# upstream dataset.

# --- browser variables -------------------------------------------------
# Create React App inlines every REACT_APP_* variable into the JavaScript
# bundle, so anything here is public. Restrict these keys by HTTP referrer.

# YouTube Data API v3. Without this the video tab shows an error.
# Each search costs 100 quota units against a 10,000/day default, so the free
# tier is about 100 searches per day.
REACT_APP_YOUTUBE_API_KEY=your_youtube_data_api_v3_key

# Serve the exercise media from your own host instead of the jsDelivr CDN.
# Both must end with a trailing slash.
# REACT_APP_IMG_BASE=/media/img/
# REACT_APP_GIF_BASE=/media/gif/

# --- server variables --------------------------------------------------
# Read only by api/chat.js, which runs as a Vercel function. Deliberately NOT
# prefixed REACT_APP_: that prefix would publish the key to every visitor.
# Set this in the Vercel dashboard, not in a committed file.

ANTHROPIC_API_KEY=your_anthropic_api_key
