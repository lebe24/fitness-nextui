# Copy this file to .env.local, then restart the dev server. Create React App
# only exposes variables prefixed with REACT_APP_.
#
# The exercise catalogue and its media need no key: the data ships in
# public/exercises.json and the images come from a pinned CDN copy of the
# upstream dataset. Only video search needs a key.

# YouTube Data API v3. Without this the video tab shows an error.
# Note: each search costs 100 quota units against a 10,000/day default, so the
# free tier is about 100 searches per day. Restrict the key by HTTP referrer.
REACT_APP_YOUTUBE_API_KEY=your_youtube_data_api_v3_key

# Serve the exercise media from your own host instead of the jsDelivr CDN.
# Both must end with a trailing slash.
# REACT_APP_IMG_BASE=/media/img/
# REACT_APP_GIF_BASE=/media/gif/
